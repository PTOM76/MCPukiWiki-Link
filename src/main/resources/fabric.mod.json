{
  "schemaVersion": 1,
  "id": "pkwklink",
  "version": "${version}",
  "name": "PukiWiki Link",
  "description": "Linking pukiwiki and minecraft for fabric",
  "authors": [
    "pitan76"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/pukiwiki-link",
    "sources": "https://github.com/PTOM76/MCPukiWiki-Link"
  },
  "license": "MIT",
  "icon": "assets/pkwklink/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "net.pitan76.pkwklink.client.PukiWikiLinkClient"
    ],
    "main": [
      "net.pitan76.pkwklink.PukiWikiLink"
    ]
  },
  "mixins": [
    "pkwklink.mixins.json",
    {
      "config": "pkwklink.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": "*",
    "fabric": "*",
    "minecraft": "*"
  }
}
